{
  "name": "Agenda – métricas diárias",
  "nodes": [
    { "parameters": { "rule": { "interval": [ { "field": "cronExpression", "expression": "0 23 * * *" } ] } },
      "name": "Todo dia 23h", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0] },
    { "parameters": {
        "method": "POST",
        "url": "https://SEU-APP.vercel.app/api/cron/metrics",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "x-cron-secret", "value": "COLE_AQUI_O_CRON_SECRET" } ] },
        "options": { "timeout": 60000 } },
      "name": "Chamar /api/cron/metrics", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [260, 0] }
  ],
  "connections": { "Todo dia 23h": { "main": [ [ { "node": "Chamar /api/cron/metrics", "type": "main", "index": 0 } ] ] } },
  "settings": { "executionOrder": "v1" }
}
