{
  "name": "YouTube – subir vídeos da fila",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "name": "A cada 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://SEU-APP.vercel.app/api/yt/next",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "COLE_AQUI_O_CRON_SECRET"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "name": "Próximo vídeo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        }
      },
      "name": "Tem vídeo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.video_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          },
          "timeout": 300000
        }
      },
      "name": "Baixar arquivo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $('Próximo vídeo').item.json.title }}",
        "regionCode": "BR",
        "categoryId": "={{ $('Próximo vídeo').item.json.category_id }}",
        "binaryProperty": "data",
        "options": {
          "description": "={{ $('Próximo vídeo').item.json.description }}",
          "tags": "={{ $('Próximo vídeo').item.json.tags }}",
          "privacyStatus": "private",
          "publishAt": "={{ $('Próximo vídeo').item.json.publish_at }}",
          "selfDeclaredMadeForKids": false,
          "notifySubscribers": false
        }
      },
      "name": "YouTube – Upload (Meu canal)",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        960,
        -60
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://SEU-APP.vercel.app/api/yt/report",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "COLE_AQUI_O_CRON_SECRET"
            }
          ]
        },
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('Próximo vídeo').item.json.id, youtube_video_id: ($json.uploadId || $json.id) }) }}"
      },
      "name": "Avisar: subiu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://SEU-APP.vercel.app/api/yt/report",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "COLE_AQUI_O_CRON_SECRET"
            }
          ]
        },
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('Próximo vídeo').item.json.id, error: 'Upload YouTube: ' + ($json.error?.message || $json.error || JSON.stringify($json)) }) }}"
      },
      "name": "Avisar: erro no upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://SEU-APP.vercel.app/api/yt/report",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "COLE_AQUI_O_CRON_SECRET"
            }
          ]
        },
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('Próximo vídeo').item.json.id, error: 'Download do arquivo: ' + ($json.error?.message || $json.error || JSON.stringify($json)) }) }}"
      },
      "name": "Avisar: erro no download",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        160
      ]
    }
  ],
  "connections": {
    "A cada 5 min": {
      "main": [
        [
          {
            "node": "Próximo vídeo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Próximo vídeo": {
      "main": [
        [
          {
            "node": "Tem vídeo?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tem vídeo?": {
      "main": [
        [
          {
            "node": "Baixar arquivo",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Baixar arquivo": {
      "main": [
        [
          {
            "node": "YouTube – Upload (Meu canal)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Avisar: erro no download",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "YouTube – Upload (Meu canal)": {
      "main": [
        [
          {
            "node": "Avisar: subiu",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Avisar: erro no upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}