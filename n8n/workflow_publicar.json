        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "x-cron-secret", "value": "COLE_AQUI_O_CRON_SECRET" } ] },
        "options": { "timeout": 60000 } },
      "name": "Chamar /api/cron/publish", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [260, 0] }
  ],
  "connections": { "A cada 5 minutos": { "main": [ [ { "node": "Chamar /api/cron/publish", "type": "main", "index": 0 } ] ] } },
  "settings": { "executionOrder": "v1" }
}
