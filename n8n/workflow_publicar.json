{
  "name": "Agenda – publicar posts agendados",
  "nodes": [
    { "parameters": { "rule": { "interval": [ { "field": "minutes", "minutesInterval": 5 } ] } },
      "name": "A cada 5 minutos", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0] },
    { "parameters": {
        "method": "POST",
